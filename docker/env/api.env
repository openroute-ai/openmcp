# apps/api runtime env — loaded ONLY by the `api` s6 service.
#
# This file is api's alone. It is never shared with web or doc. Override by
# mounting your own file over this path:
#
#   docker run ... -v $PWD/api.env:/etc/s6/api.env:ro openmcp-stack
#
# DATABASE_URL and BETTER_AUTH_SECRET are REQUIRED (apps/api/src/lib/env.ts).

# Port the API binds (api service default).
PORT=8080

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/openmcp

# --- Auth (required) ---
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Web app base for the Store MCP proxy (optional).
# OPENMCP_WEB_BASE_URL=http://localhost:3000
