# apps/doc runtime env — loaded ONLY by the `doc` s6 service.
#
# This file is doc's alone. It is never shared with web or api. Override by
# mounting your own file over this path:
#
#   docker run ... -v $PWD/doc.env:/etc/s6/doc.env:ro openmcp-stack
#
# See apps/doc/.env.local.example for the chat settings.

# Port the docs server binds (doc service default).
PORT=3001

# Public origin used in llms/discovery links. Point at your real domain.
NEXT_PUBLIC_BASE_URL=https://docs.openmcp.cn

# --- AI chat (optional; endpoint returns 503 when unset) ---
# Prefers AI_CHAT_*, falls back to DEEPSEEK_* / OPENAI_*.
# AI_CHAT_BASE_URL=https://api.deepseek.com
# AI_CHAT_API_KEY=
# AI_CHAT_MODEL=deepseek-chat
# CHAT_RATE_LIMIT_PER_MIN=10
# CHAT_MAX_STEPS=6
