# apps/web runtime env — loaded ONLY by the `web` s6 service.
#
# This file is web's alone. It is never shared with doc or api: each service in
# this image reads its own file (/etc/s6/web.env, /etc/s6/doc.env, /etc/s6/api.env)
# so the three apps' variables cannot collide.
#
# The values below are safe placeholders so the container boots out of the box.
# Override by mounting your own file over this path at run time:
#
#   docker run ... -v $PWD/web.env:/etc/s6/web.env:ro openmcp-stack
#
# See apps/web/.env.example for the full list of server-side settings.

# Port the web server binds (web service default).
PORT=3000

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/openmcp

# --- Auth (required) ---
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Public origin, used for links / OAuth redirects. Point at your real domain.
NEXT_PUBLIC_BASE_URL=https://www.openmcp.cn
NEXT_PUBLIC_APP_URL=https://api.openmcp.cn
