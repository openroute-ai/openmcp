# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# Env copies parked under another name; a `git add -A` would otherwise commit
# them, and they carry the same secrets the entries above protect.
.env-back
.env-*
# The one exception below is public build-time config, not a secret: `next build`
# reads it locally and inside apps/console/Dockerfile to inline the site
# identity, so it has to be tracked. Every other .env.production (e.g.
# apps/web's, which carries credentials) stays ignored by the entries above.
!apps/console/.env.production
# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem
# Windows / OneDrive marks downloaded files with an NTFS alternate-data-stream
# sidecar. On a non-NTFS checkout it lands as a literal `name:Zone.Identifier`
# file, which a `git add -A` would otherwise commit.
*:Zone.Identifier

# AI
.claude/

# fumadocs-mdx generated
.source/
apps/console/public/report/