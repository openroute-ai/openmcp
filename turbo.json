    "BANK_TRANSFER_BANK_NAME",
    "BANK_TRANSFER_BRANCH_NAME",
    "CHAT_MAX_STEPS",
    "CHAT_RATE_LIMIT_PER_MIN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CONSOLE_API_BASE_URL",
    "CONSOLE_API_KEY",
    "CONSOLE_BETTER_AUTH_URL",
    "CONSOLE_DATABASE_POOL_MAX",
    "CONSOLE_DATABASE_SSL",
    "CONSOLE_DATABASE_URL",
    "CONSOLE_SKILLS_CALLBACK_SECRET",
    "CONSOLE_SKILLS_CALLBACK_URL",
    "CONSOLE_SKILLS_REGISTER_ONLY",
    "CONSOLE_TEMP_EMAIL_DOMAIN",
    "CRON_SECRET",
    "DAILY_WEBHOOK_TOKEN",
    "DATABASE_URL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "DEEPSEEK_MODEL",
    "DISCORD_MONTHLY_WEBHOOK",
    "ENABLE_LOCAL_CRON",
    "FRONTEND_BUILD_WEB_HOOK",
    "GATEWAY_SECRET_KEY",
    "GATEWAY_SETTLEMENT_DAYS",
    "GATEWAY_SETTLEMENT_INTERVAL_SEC",
    "GITHUB_ACCESS_TOKEN",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_DATA_WEBHOOK_SECRET",
    "GITHUB_DATA_WEBHOOK_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "LITELLM_BASE_URL",
    "LITELLM_MASTER_KEY",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "MAIL_FROM",
    "MAIL_PROVIDER",
    "MAIL_SUPPORT",
    "MISTRAL_API_KEY",
    "MONTHLY_WEBHOOK_URL",
    "NEWSLETTER_PROVIDER",
    "NEXT_PHASE",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_BASE_URL",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "PAYMENT_PROVIDER",
    "PAYMENT_SIMULATE",
    "PORT",
    "RANKINGS_ROOT_URL",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "RESEND_API_KEY",
    "SCAN_FILE_MAX_SIZE",
    "SKILLS_AUTO_PUBLISH_GRADES",
    "SKILLS_WEBHOOK_TOKEN",
    "SLACK_WEBHOOK_URL",
    "SMTP_HOST",
    "SMTP_FROM",
    "SMTP_PASS",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET_NAME",
    "STORAGE_ENDPOINT",
    "STORAGE_FORCE_PATH_STYLE",
    "STORAGE_OSS_INTERNAL",
    "STORAGE_OSS_SECURE",
    "STORAGE_PROVIDER",
    "STORAGE_PUBLIC_URL",
    "STORAGE_REGION",
    "STORAGE_SECRET_ACCESS_KEY",
    "TENCENT_SMS_REGION",
    "TENCENT_SMS_SDK_APP_ID",
    "TENCENT_SMS_SECRET_ID",
    "TENCENT_SMS_SECRET_KEY",
    "TENCENT_SMS_SIGN_NAME",
    "TENCENT_SMS_TEMPLATE_ID",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "WECHAT_API_V3_KEY",
    "WECHAT_APP_ID",
    "WECHAT_MCH_CERT_SERIAL",
    "WECHAT_MCH_ID",
    "WECHAT_PRIVATE_KEY",
    "WEEKLY_WEBHOOK_URL",
    "WEWORK_AGENTID",
    "WEWORK_CORPID",
    "WEWORK_CORPSECRET",
    "WEWORK_TOPARTY",
    "WEWORK_TOTAG",
    "WEWORK_TOUSER",
    "WEWORK_WEBHOOK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
