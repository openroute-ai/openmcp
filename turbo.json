{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ALIYUN_ACCESS_KEY_ID",
    "ALIYUN_ACCESS_KEY_SECRET",
    "ALIYUN_OSS_BUCKET",
    "ALIYUN_OSS_REGION",
    "API_TRIGGER_BUILD_WEBHOOK_URL",
    "AZURE_TRANSLATOR_KEY",
    "AZURE_TRANSLATOR_REGION",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CONSOLE_API_TOKEN",
    "CONSOLE_BETTER_AUTH_URL",
    "CONSOLE_DATABASE_URL",
    "CONSOLE_DATABASE_POOL_MAX",
    "CONSOLE_DATABASE_SSL",
    "CONSOLE_TEMP_EMAIL_DOMAIN",
    "CRON_SECRET",
    "DATABASE_URL",
    "DAILY_WEBHOOK_TOKEN",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "DEEPSEEK_MODEL",
    "DISCORD_MONTHLY_WEBHOOK",
    "FRONTEND_BUILD_WEB_HOOK",
    "GITHUB_ACCESS_TOKEN",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_DATA_WEBHOOK_SECRET",
    "GITHUB_DATA_WEBHOOK_URL",
    "MISTRAL_API_KEY",
    "MONTHLY_WEBHOOK_URL",
    "NEXT_PHASE",
    "NODE_ENV",
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "PORT",
    "RANKINGS_ROOT_URL",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "SKILLS_WEBHOOK_TOKEN",
    "SKILLS_WEBHOOK_URL",
    "SLACK_WEBHOOK_URL",
    "TENCENT_SMS_REGION",
    "TENCENT_SMS_SDK_APP_ID",
    "TENCENT_SMS_SECRET_ID",
    "TENCENT_SMS_SECRET_KEY",
    "TENCENT_SMS_SIGN_NAME",
    "TENCENT_SMS_TEMPLATE_ID",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "WEEKLY_WEBHOOK_URL",
    "WEWORK_AGENTID",
    "WEWORK_CORPID",
    "WEWORK_CORPSECRET",
    "WEWORK_TOTAG",
    "WEWORK_TOUSER",
    "WEWORK_TOPARTY",
    "WEWORK_WEBHOOK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
