# OpenMCP local development — copy to .env and fill in
NODE_ENV=development

# App URL (openmcp dev server defaults to port 30021)
NEXT_PUBLIC_BASE_URL=http://localhost:30021
NEXT_PUBLIC_APP_URL=http://localhost:30021
BETTER_AUTH_URL=http://localhost:30021
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Store MCP OAuth uses opaque tokens (omt_*) hashed in oauth_tokens — no JWT_SECRET required.
# BETTER_AUTH_SECRET still powers session cookies for /device authorization.
# Optional legacy alias (unused by current Store MCP opaque-token path):
# JWT_SECRET=your-long-random-secret-key-min-32-chars

# Public site URL used in Store MCP discovery + OAuth verification_uri
# NEXT_PUBLIC_BASE_URL=http://localhost:20001
# NEXT_PUBLIC_GATEWAY_BASE_URL=https://api.openmcp.cn

# Gateway OAuth secret encryption (uses BETTER_AUTH_SECRET if not set)
# Required for OAuth Mode ① (platform-held authorization)
# GATEWAY_SECRET_KEY=your-long-random-secret-key-min-32-chars

# Postgres 16
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/n8nshow
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/n8nshow

# Redis 7 (chat rate-limit etc.)
REDIS_URL=redis://127.0.0.1:6379

# Content sources (defaults are fine for local)
DOCS_SOURCE=file
BLOG_SOURCE=file
USE_MDX_REMOTE=false

# Optional: AI / email / OAuth / storage — only when enabling those features
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Skills scan auto-publish grades (comma-separated). Default: safe
# caution is pending_review unless listed here. Hard rules: unsafe→pending_review, reject→rejected
SKILLS_AUTO_PUBLISH_GRADES=safe

# ===========================================================================
# apps/console — publishing and skill sync
# ===========================================================================
#
# Two independent credentials, because the two directions have opposite blast
# radii and must not be collapsed into one "console token".
#
# 1. This app → console, `POST /api/v1/projects`. Carries `projects:write`, so
#    it can publish a repository and name where console delivers the resulting
#    skill documents. Without it a submission still succeeds, it just stays
#    local.
# 2. This app → console, `GET /api/skills-sync/export`. Read-only, and the
#    safety net for a push that was dropped while this app was restarting. It
#    re-applies the security scan, so a repaired skill lands published-or-queued
#    rather than stuck in `scanning`.

# Public origin of apps/console. Left unset, this app runs as a single app and
# simply does not propagate upstream.
# CONSOLE_API_BASE_URL=http://localhost:20002

# 提交到 console 时，只登记、不发布（默认 false = 发布）。
#
# false（本文件默认）：提交走 POST /api/v1/projects —— console 建 project，
#   仓库因此出现在公开站，技能文档会被同步并回推到本应用。
# true：提交走 POST /api/v1/repos —— console 只写 repos + user_repos，
#   **不建 project、不公开、不回推任何技能文档**。
#
# 归属记在 key 的 submitter_id 上，即"本应用这个平台账号"，而不是粘贴 URL 的
# 终端用户：一把 service key 承载所有用户的提交，所以所有 user_repos 行都落在
# 运维为这把 key 签发的那一个账号下。
#
# 切换后需要重新签发 key：publish 模式要 projects:write（admin 授予），
# register 模式只要 repos:write。scope 不匹配会得到 403，而不是静默失败。
#
# 该模式没有任何东西会到达本应用，所以提交弹窗不会等待技能文档。
# CONSOLE_SKILLS_REGISTER_ONLY=false
#
# Bearer for `POST /api/v1/projects` / `POST /api/v1/repos`. Mint it on console at
# /dashboard/api-keys: it is a row in console's `api_keys` table, so it can be
# revoked on its own and carries scopes. Which scope it needs depends on
# CONSOLE_SKILLS_REGISTER_ONLY above. `projects:write` is admin-granted and
# deliberately not self-service, because publishing is what puts a repository on
# the public site.
# CONSOLE_API_KEY=

# GitHub import / rescan runs the security scanner on console via
# POST /api/v1/skills/scan (SKILL_SECURITY_SCAN_PIPELINE §7). CONSOLE_API_KEY
# above is the credential and must additionally carry the `skills:scan` scope
# when the remote path is wanted; without it the call answers 403 and the import
# falls back to scanning the local snapshot. SCAN_FILE_MAX_SIZE bounds how much
# of a single file that fallback reads.
# SCAN_FILE_MAX_SIZE=5242880

# Bearer for `GET /api/skills-sync/export`, shared with console's
# SKILLS_WEBHOOK_TOKEN so both sides read one value. Unset leaves the export
# route failing closed with 404, and skips the cron that walks it.
# SKILLS_WEBHOOK_TOKEN=

# The HMAC key handed to console as `callbackSecret` when this app submits a
# repository, and therefore the key console signs each skill delivery with.
#
# Kept separate from SKILLS_WEBHOOK_TOKEN: that one authorises *reading* console's
# export, this one authorises console to *push* to this app. One shared value
# would let a holder of the read token also forge skill documents.
#
# Also accepted, when set, as a bearer on the inbound push, so a console that
# predates per-submitter callbacks keeps working. Unset and no
# WEB_SKILLS_INGEST_TOKEN either means the inbound route 404s.
#
# Only relevant when publishing: with CONSOLE_SKILLS_REGISTER_ONLY=true no
# skill is ever pushed, so this key and CONSOLE_SKILLS_CALLBACK_URL are unused.
# CONSOLE_SKILLS_CALLBACK_SECRET=
#
# Absolute address console pushes to. Defaults to
# <NEXT_PUBLIC_BASE_URL or this app's origin>/api/webhook/daily/skills, which is
# right in local dev. Set it explicitly behind a proxy, custom domain or tunnel:
# a wrong value here fails quietly, because console accepts the submission and
# then pushes into nothing — the only symptom is a skill left in its retry queue.
# CONSOLE_SKILLS_CALLBACK_URL=http://localhost:20001/api/webhook/daily/skills
#
# Preferred inbound bearer, tried after the signature above.
# WEB_SKILLS_INGEST_TOKEN=
#
# Cron-grade only: with CRON_SECRET set on both sides, POST /api/cron/github
# runs console's whole task graph on demand. Unused by the submit path — let
# console's own Vercel Cron drive it. Unset disables console's scheduler route
# outright, and that one is shared with its cron config.
# CRON_SECRET=

# LiteLLM Gateway (for MCP/A2A OAuth Mode ①)
# LITELLM_BASE_URL=http://127.0.0.1:4000

# --- Wallet recharge (top-up) ---
# Development only. Enables the simulated WeChat/Alipay top-up flow, which
# mints a signed callback and runs it through the real settlement service.
# Never enable in production: the simulated gateway is unavailable there and
# /api/pay/simulate/* returns 404.
PAYMENT_SIMULATE=false

# Online channel used by /settings/recharge (wechat | alipay). Stripe is not a
# top-up channel today.
PAYMENT_PROVIDER=wechat

# Production WeChat Pay Native (API v3) top-up. Required when PAYMENT_SIMULATE
# is false and PAYMENT_PROVIDER=wechat. Never commit real secrets.
# Notify URL defaults to ${NEXT_PUBLIC_APP_URL}/api/webhook/wechat when unset.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_CERT_SERIAL=
WECHAT_PRIVATE_KEY=
# WeChat Pay platform public key (PEM) for verifying Wechatpay-Signature.
# From the merchant console (微信支付公钥) or a downloaded platform certificate.
WECHAT_PLATFORM_PUBLIC_KEY=
# WECHAT_NOTIFY_URL=https://your.domain/api/webhook/wechat

# Production Alipay face-to-face / precreate top-up. Required when
# PAYMENT_SIMULATE is false and PAYMENT_PROVIDER=alipay.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Leave empty for sandbox (openapi.alipaydev.com); set production gateway explicitly:
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=https://your.domain/api/webhook/alipay

# 对公转账 (corporate bank transfer) receiving account, shown to payers on
# /settings/recharge. Configure per deployment; never hardcode in components.
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BRANCH_NAME=

# Object storage, required by /api/storage/upload and /api/storage/presigned-url
# (KYC documents, payout QR codes, listing covers, skill archives).
# All five values below are mandatory: the upload endpoints return 503 without
# them rather than falling back to a pre-signed read URL, which would expire and
# leave a dead link once stored on a provider profile or listing row.
# STORAGE_PROVIDER=s3            # s3 | oss
# STORAGE_REGION=                # required, e.g. cn-hangzhou / us-east-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=
# STORAGE_PUBLIC_URL=            # e.g. https://cdn.example.com
# STORAGE_ENDPOINT=              # optional, S3-compatible / OSS endpoint.
#                                 # For OSS the bucket label is optional:
#                                 # https://oss-cn-hangzhou.aliyuncs.com is
#                                 # equivalent to https://my-bucket.oss-cn-hangzhou.aliyuncs.com
# STORAGE_FORCE_PATH_STYLE=true  # set false for virtual-hosted-style buckets
# STORAGE_OSS_INTERNAL=false     # use the intranet OSS endpoint
# STORAGE_OSS_SECURE=true        # HTTPS against OSS
