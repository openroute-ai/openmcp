# apps/console environment.
#
# Everything here is read either by this app or by one of the workspace packages
# it depends on (`@workspace/mail`, `@workspace/sms-captcha`). Nothing is listed
# speculatively: a variable with no reader is gone rather than commented out, so
# what remains is exactly what the app can act on.
#
# Optional variables are shown commented out and unset. That is a real state,
# not a placeholder — most of them disable one integration while leaving the
# rest of the app working, and the code treats "unset" as "off" rather than as
# an error.

# ===========================================================================
# Required
# ===========================================================================

# Shared with the other apps. Signs sessions and tokens; a short value here is a
# forgeable session cookie everywhere.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# Origins allowed to post to the auth endpoints. Must include the app's own
# origin or every sign-in is rejected as an untrusted origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:20002

# The app's own URL, including scheme and port. Better Auth builds its own
# cookies and OAuth redirects from this, so it has to name the port the server
# actually binds.
BETTER_AUTH_URL=http://localhost:20002

# apps/console owns its database, separate from apps/web's `DATABASE_URL`.
# The two schemas overlap by table name and differ in column conventions, so
# pointing both at one database corrupts both. Never share it, and never read
# the other app's URL to work around it.
CONSOLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/console

# Fine-grained personal access token for every GitHub REST + GraphQL call.
# Required by the sync domain: the anonymous rate limit is 60 requests/hour,
# which one sync run exhausts, and it silently returns different data for
# private repositories. The app refuses to run the domain tasks without it
# rather than falling back to anonymous.
GITHUB_ACCESS_TOKEN=

# Bearer for the scheduler (GET/POST /api/cron/github), sent automatically by
# Vercel Cron as `Authorization: Bearer $CRON_SECRET`. Leaving it unset
# disables the endpoint outright — it fails closed with 404, because an unset
# secret must never degrade into an unauthenticated trigger for jobs that write
# to the database and push webhooks.
CRON_SECRET=

# ===========================================================================
# Port and TLS
# ===========================================================================

# Read by `next start` itself, not by application code — `pnpm dev` pins the
# port on the command line instead. Without it `next start` binds 3000, which is
# apps/web's port.
PORT=20002

# Managed providers (Supabase, Neon, RDS) serve their certificate from a
# private CA that Node does not trust, so the app resolves SSL from the host:
# localhost connects in the clear, anything else connects encrypted but
# unverified (`ssl: { rejectUnauthorized: false }`). Accepted values:
# `no-verify` keeps TLS on but skips the certificate check (same as the
# default), `disable` turns TLS off entirely, and `require` verifies against
# the platform trust store.
# CONSOLE_DATABASE_SSL=no-verify
#
# Do not put `?sslmode=...` in the URL. `pg` parses the connection string and
# lets the result overwrite the `ssl` option above, and `sslmode=require` is
# currently an alias for `verify-full` — the error this setup avoids.
#
# CONSOLE_DATABASE_POOL_MAX bounds the connection pool (default 10).
# CONSOLE_DATABASE_POOL_MAX=10

# ===========================================================================
# Redis — auth rate limiting and the task lock
# ===========================================================================
#
# Both drivers are supported and Upstash wins when configured, because on
# Vercel the only reachable Redis is the REST one and a leftover `REDIS_*` would
# otherwise make every request block on a connect timeout to localhost first.
# With neither configured, rate limiting falls back to per-process state.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# A self-hosted Redis, as one URL.
# REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ...or as parts, used only when REDIS_URL is unset. REDIS_DB is read by
# @workspace/sms-captcha, which shares this connection.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===========================================================================
# Authentication providers
# ===========================================================================

# GitHub OAuth login. Unset hides the "Sign in with GitHub" button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tencent Cloud SMS for the phone-number OTP. All five are required together;
# leaving them unset runs SMS in test mode, where the code is logged to the
# server console instead of sent.
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# Domain for the auto-generated email of phone-created accounts
# (e.g. 13800000000@console.local).
# CONSOLE_TEMP_EMAIL_DOMAIN=console.local

# The machine API under /api/v1 has no token here on purpose: it authenticates
# each caller against a hashed key in the `api_keys` table, so a key is granted
# and revoked per integration and per scope, rather than one site-wide secret
# deciding everything. Mint one from the admin UI or `apiKeys.create`.
#
# Publishing a repository — POST /api/v1/projects — needs `projects:write`,
# which is admin-granted and deliberately absent from self-service issuance.
# That endpoint is also where a submitter supplies its own skills destination
# (callbackUrl / callbackSecret), so this scope is what lets a caller name
# where console delivers that repository's skill documents.

# ===========================================================================
# Site identity
# ===========================================================================
#
# What this site calls itself, and what it calls itself in English. Every page's
# title, the sitemap, `llms.txt` and the JSON-LD are rendered from these, so
# renaming the product is a deploy of this block and nothing else.
#
# Read at build time on purpose: these must be inline `process.env.NEXT_PUBLIC_*`
# references, because Next replaces them literally in the client bundle at build
# time. A computed lookup (`process.env[name]`) is not replaced, and the browser
# gets `undefined` instead of the site name.
#
# `SITE_ORIGIN` has a second job: it is `metadataBase`, so every relative URL a
# page emits — canonical, OG image, sitemap entry — is resolved against it. It
# must be the public origin, including the scheme, and it must not have a path.
NEXT_PUBLIC_SITE_ORIGIN=https://vercelai.cn
NEXT_PUBLIC_SITE_HOST=vercelai.cn
NEXT_PUBLIC_SITE_NAME=AI雷达
NEXT_PUBLIC_SITE_NAME_EN=AI Radar
NEXT_PUBLIC_SITE_TAGLINE=记录 stargazer 的到达时间，判断开源项目正在变好还是变坏。
NEXT_PUBLIC_SITE_DESCRIPTION=AI雷达记录每个 stargazer 到达 GitHub 的时间，据此判断一个开源项目正在变好还是变坏。周榜、月榜、年度飙升榜与异动流都以原始星标增量、相对增速和维护停滞证据对外提供，每条结论都能点开复核。

# The repository the footer links to and the only `sameAs` the Organization
# node declares. Unset falls back to this project's own repository.
NEXT_PUBLIC_SITE_GITHUB_URL=https://github.com/openroute-ai/openmcp

# The long-form documentation host. Kept separate from `SITE_ORIGIN` because it
# is a different deployment (the docs app) and it can move without this app
# redeploying — `/docs` and `/llms.txt` link to it as the reference for the
# endpoints that need a credential.
NEXT_PUBLIC_SITE_DOCS_ORIGIN=/docs

# ===========================================================================
# Analytics
# ===========================================================================
#
# Umami page views, loaded by `UmamiAnalytics` from `@workspace/shared-next`
# (packages/shared-next/src/analytics/umami-analytics.tsx). Both variables are
# required together: with either missing the component renders nothing, so
# leaving them commented out is the supported "off" state rather than an
# error. The component also renders nothing outside production, so a dev
# server never sends a beacon even when both are set.
#
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT=

# ===========================================================================
# Skill documents: the pull direction
# ===========================================================================
#
# There is no deployment-wide skills endpoint. Where a repository's skill
# documents are *pushed* is decided by whoever submitted it, which the
# `projects:write` caller states per request as `callbackUrl` /
# `callbackSecret`; console records that pair on the project row and signs
# every delivery with it. See `projects.skills_webhook_url`.
#
# This token is the other direction. It authorises reading skill documents out
# of this console — GET /api/skills-sync/export — and nothing else, so holding
# it grants no ability to push to any submitter. It is also the safety net for
# the push path: a destination that was wrong or unreachable while the submitter
# restarted leaves rows queued on their side that only this endpoint can
# resolve.
#
# Apps/web reads the same name to pull, so sharing one value here and there is
# what makes the safety net work. Unset fails the export closed with 404.
SKILLS_WEBHOOK_TOKEN=

# ===========================================================================
# Outbound notifications
# ===========================================================================
#
# None of these have a receiver inside this repository; they exist so an
# operator can point the periodic data tasks at their own endpoints. Every one
# is optional and a missing endpoint leaves that task's work already done
# rather than failing the run.

# Periodic GitHub statistics sync. Multiple endpoints may be separated by `;`.
# Setting the secret signs each request with HMAC-SHA256 over
# `<unix-timestamp>.<body>`.
# GITHUB_DATA_WEBHOOK_URL=
# GITHUB_DATA_WEBHOOK_SECRET=

# Weekly and monthly ranking digests, plus the bearer attached to all three
# ranking webhooks.
# WEEKLY_WEBHOOK_URL=
# MONTHLY_WEBHOOK_URL=
# DAILY_WEBHOOK_TOKEN=

# Upstream build hooks, so a frontend revalidates after a data refresh.
# API_TRIGGER_BUILD_WEBHOOK_URL=

# Public root of the rankings frontend, for building absolute links.
# RANKINGS_ROOT_URL=

# WeCom (企业微信) group robot. The daily digest is skipped when the URL is
# unset.
# WEWORK_WEBHOOK_URL=
# WEWORK_CORPID=
# WEWORK_CORPSECRET=
# WEWORK_AGENTID=
# WEWORK_TOPARTY=
# WEWORK_TOTAG=
# WEWORK_TOUSER=

# Monthly ranking to chat.
# DISCORD_MONTHLY_WEBHOOK=
# SLACK_WEBHOOK_URL=

# ===========================================================================
# Translation
# ===========================================================================
#
# Skill and README translation to Chinese. Each provider is independent and a
# missing one disables only itself; with none configured, translation is skipped
# and the English source text is stored as-is.
#
# Deterministic document translation:
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
#
# OpenAI-compatible chat completion, used for the AI translation path. The first
# configured provider wins: OpenAI needs both the key and the base URL,
# DeepSeek needs only the key, and OLLAMA_BASE_URL alone selects a local model.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# ===========================================================================
# Aliyun OSS
# ===========================================================================
#
# Required by the tasks that publish JSON artefacts and mirror repository icons
# and Open Graph images. All four are needed together; the publish step is
# skipped when any is missing.
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=

# ===========================================================================
# Mail
# ===========================================================================
#
# Verification codes and the newsletter. Provider is `nodemailer` unless
# MAIL_PROVIDER says otherwise. With no SMTP credentials the mailer falls back
# to MailHog on localhost:1025, which is why `isMailConfigured()` tests for
# credentials rather than for a config object.

# MAIL_PROVIDER=nodemailer
# MAIL_FROM=
# SMTP_FROM=

# nodemailer: MAIL_FROM/SMTP_FROM is the sender; the rest are the credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# resend: only the API key is needed.
# RESEND_API_KEY=
# ===========================================================================
# Skill security scan
# ===========================================================================
#
# `POST /api/v1/skills/scan` (scope `skills:scan`) fetches a repository and runs
# the security scanner. How it fetches depends on the runtime:
#
# - On Vercel (VERCEL=1 or VERCEL_ENV set) a @vercel/sandbox sandbox fetches the
#   repository. SKILL_SCAN_VERCEL_MODE picks where the rules run:
#     sandbox    (default) rules run inside the sandbox; source stays there
#                unless the LLM stage asks for it back
#     serverless files come back and the rules run in this function
#   In-sandbox failures fall back to serverless automatically.
# - Off Vercel the repository is `git clone`d to a temp dir
#   (SKILL_SCAN_TMP_DIR, cleaned daily by the cleanup-skill-scan-tmp task).
#
# SKILL_SCAN_VERCEL_MODE=sandbox
# SKILL_SCAN_MAX_FILES=200
# SKILL_SCAN_MAX_TOTAL_BYTES=10485760
# SKILL_SCAN_MAX_FILE_BYTES=1048576
# SKILL_SCAN_SANDBOX_TIMEOUT_MS=120000
# SKILL_SCAN_COMMAND_TIMEOUT_MS=60000
# SKILL_SCAN_SANDBOX_VCPUS=1
# SKILL_SCAN_TMP_DIR=/tmp/skills-scan
# SKILL_SCAN_TMP_MAX_AGE_HOURS=24
