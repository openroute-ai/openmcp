# Shared with the other apps
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# apps/console runs on its own port
CONSOLE_BETTER_AUTH_URL=http://localhost:3001

# apps/console uses its own database, separate from DATABASE_URL
CONSOLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/console
