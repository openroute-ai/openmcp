# Shared with the other apps
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# apps/console runs on its own port
CONSOLE_BETTER_AUTH_URL=http://localhost:3001

# apps/console uses its own database, separate from DATABASE_URL
CONSOLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/console

# Redis backing for the auth rate limiter (required for Redis rate limiting).
# Prefer a single REDIS_URL; the discrete REDIS_* vars are also supported.
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# When REDIS_URL is unset, this app falls back to these:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# GitHub OAuth login. Leave unset to hide the "Sign in with GitHub" button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tencent Cloud SMS for the phone-number OTP. Leave unset to run in test
# mode (the code is logged to the server console instead of sent).
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# Domain used for the auto-generated email of accounts created by phone
# sign-in (e.g. 13800000000@console.local). Optional.
# CONSOLE_TEMP_EMAIL_DOMAIN=console.local
