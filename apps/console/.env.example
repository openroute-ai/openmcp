# Shared with the other apps
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# apps/console runs on its own port
CONSOLE_BETTER_AUTH_URL=http://localhost:3001

# apps/console uses its own database, separate from DATABASE_URL
CONSOLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/console

# Redis backing for the auth rate limiter (required for Redis rate limiting).
# Prefer a single REDIS_URL; the discrete REDIS_* vars are also supported.
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# When REDIS_URL is unset, this app falls back to these:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# GitHub OAuth login. Leave unset to hide the "Sign in with GitHub" button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tencent Cloud SMS for the phone-number OTP. Leave unset to run in test
# mode (the code is logged to the server console instead of sent).
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# Domain used for the auto-generated email of accounts created by phone
# sign-in (e.g. 13800000000@console.local). Optional.
# CONSOLE_TEMP_EMAIL_DOMAIN=console.local

# ===========================================================================
# GitHub data sync domain
# ===========================================================================

# Fine-grained personal access token used for every GitHub REST + GraphQL
# call. Required by the sync domain; the app refuses to run the domain
# tasks without it.
GITHUB_ACCESS_TOKEN=

# Bearer token for machine-to-machine calls to the internal ingest API
# (POST /api/internal/repos). Leave unset to disable the endpoint entirely.
CONSOLE_API_TOKEN=

# Bearer token for the scheduler endpoint (GET/POST /api/cron/github).
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
# Leave unset to disable the endpoint entirely (it fails closed).
CRON_SECRET=

# Outbound webhook that receives the periodic GitHub statistics sync.
# Multiple endpoints can be separated by `;`. When
# GITHUB_DATA_WEBHOOK_SECRET is set, requests are signed with HMAC-SHA256.
# GITHUB_DATA_WEBHOOK_URL=
# GITHUB_DATA_WEBHOOK_SECRET=

# Outbound webhooks for the weekly / monthly ranking tasks.
# WEEKLY_WEBHOOK_URL=
# MONTHLY_WEBHOOK_URL=
# Bearer token attached to the daily, weekly and monthly ranking webhooks.
# DAILY_WEBHOOK_TOKEN=

# Outbound webhook that receives synced skill documents, plus the cursor
# export endpoint (GET /api/skills-sync/export) bearer token.
# Point SKILLS_WEBHOOK_URL at the web inbound receiver:
#   SKILLS_WEBHOOK_URL=https://<web-host>/api/webhook/daily/skills
# Use the same bearer as web WEB_SKILLS_INGEST_TOKEN (or SKILLS_WEBHOOK_TOKEN).
# SKILLS_WEBHOOK_URL=
# SKILLS_WEBHOOK_TOKEN=

# Upstream build hooks triggered after a data refresh, so the frontends
# revalidate their caches.
# FRONTEND_BUILD_WEB_HOOK=
# API_TRIGGER_BUILD_WEBHOOK_URL=
# Public root URL of the rankings frontend, used to build absolute links.
# RANKINGS_ROOT_URL=

# WeCom (企业微信) group robot notifications. The daily digest is skipped
# when WEWORK_WEBHOOK_URL is unset.
# WEWORK_WEBHOOK_URL=
# WEWORK_CORPID=
# WEWORK_CORPSECRET=
# WEWORK_AGENTID=
# WEWORK_TOPARTY=
# WEWORK_TOTAG=
# WEWORK_TOUSER=

# Optional chat notifications for the monthly ranking task.
# DISCORD_MONTHLY_WEBHOOK=
# SLACK_WEBHOOK_URL=

# ===========================================================================
# Translation (README / skill / release-note translation to Chinese)
# ===========================================================================

# Azure Translator, used for the deterministic document translation.
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=

# OpenAI-compatible chat completion, used for AI translation fallbacks and
# other AI tasks. Either provider works; leave both unset to disable
# AI-based translation.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# ===========================================================================
# Aliyun OSS
# ===========================================================================

# Required by the tasks that publish JSON artefacts and mirror repository
# icons / Open Graph images. The publish step is skipped when unset.
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=
