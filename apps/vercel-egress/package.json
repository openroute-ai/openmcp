{
  "name": "vercel-egress",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild api/[[...route]].ts --bundle --platform=node --format=esm --outfile=.turbo/bundle-check.mjs --log-level=error",
    "bundle:check": "pnpm bundle && node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "^3.5.1",
    "@workspace/security-scan": "workspace:*",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^24.19.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "0.25.12",
    "eslint": "^9.39.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}