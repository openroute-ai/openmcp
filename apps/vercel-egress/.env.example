# ===========================================================================
# vercel-egress — GitHub egress proxy + Sandbox scan orchestration (Vercel)
# ===========================================================================
#
# Deployed on Vercel (Hobby) as its own project. Routes:
#   GET  /api/healthz                       — health check (Vercel only sees /api/*)
#   GET  /healthz                           — same, local dev only
#   ALL  /api/github/rest/*                 — REST forward to api.github.com
#   ALL  /api/github/graphql                — GraphQL forward to api.github.com
#   POST /api/scan                          — Sandbox security scan (Route B)
#
# Every route authenticates with `X-Egress-Secret`; nothing runs without it
# (fail closed). The GitHub token(s) live HERE, never on the domestic console.

# Shared with the domestic console. Required, at least 32 characters (fail closed).
EGRESS_SECRET=

# One or more GitHub tokens this proxy may use, comma-separated. Round-robin
# with skip-on-spent-window; leaving one in lets you rotate it out without
# taking the proxy down. Falls back to GITHUB_ACCESS_TOKEN when unset.
# GITHUB_TOKENS=ghp_aaa,ghp_bbb
GITHUB_ACCESS_TOKEN=

# Route A (forward) tuning.
# EGRESS_FORWARD_TIMEOUT_MS=30000        # per-call upstream timeout → 504 on timeout
# EGRESS_MAX_REQUEST_BODY_BYTES=1048576  # body cap → 413 above it (default 1 MiB)

# --- Sandbox scan (Route B) ---
# SKILL_SCAN_SANDBOX_VCPUS=1
# SKILL_SCAN_SANDBOX_TIMEOUT_MS=120000
# SKILL_SCAN_COMMAND_TIMEOUT_MS=60000
# SKILL_SCAN_MAX_FILES=200
# SKILL_SCAN_MAX_TOTAL_BYTES=10485760
# SKILL_SCAN_MAX_FILE_BYTES=262144

# --- LLM review (Route B, optional) ---
# Only needed when the console asks for includeLlm. Falls back to OpenAI names.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Local dev only (Vercel Functions set their own listening port).
PORT=3001